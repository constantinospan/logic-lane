+/**
+ * Does a loaded save point at a real puzzle? A damaged save (e.g. edited by hand, or written by a much older version)
+ * could otherwise reach the game with no level or seed.
+ * @param {ResumeRecord} record
+ * @returns {boolean}
+ */
+function isPosition(record) {
+  return (
+    typeof record.gameId === 'string' &&
+    Number.isInteger(record.level) &&
+    record.level >= 1 &&
+    Number.isInteger(record.n) &&
+    record.n >= 0 &&
+    typeof record.seed === 'string' &&
+    record.seed !== ''
+  );
+}
+
 /**
  * @param {{ backend?: Backend | null, now?: () => number }} [options]  Injectable for tests. `backend: null` means
  *   "no usable browser storage", which falls back to memory.
@@ -112,6 +130,7 @@ export function createStore(options = {}) {
       const fresh =
         record !== null &&
         typeof record === 'object' &&
+        isPosition(record) &&
         typeof record.savedAt === 'number' &&
         now() - record.savedAt < RESUME_WINDOW_MS &&
         record.savedAt <= now() + 60_000 && // clock moved backwards a lot: treat as stale
