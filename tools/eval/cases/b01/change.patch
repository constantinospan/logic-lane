 /** @typedef {{ emoji: string, word: string }} Thing */
 
+/** Right first time, in a row: the current run and her best. */
+const STREAK_KEY = 'logic-lane:demo-streak';
+
+/**
+ * @typedef {object} Streak
+ * @property {number} now  Puzzles solved first time in a row.
+ * @property {number} best
+ */
+
+/** @returns {Streak} */
+function loadStreak() {
+  try {
+    const saved = JSON.parse(localStorage.getItem(STREAK_KEY) ?? 'null');
+    if (saved && Number.isInteger(saved.now) && Number.isInteger(saved.best)) return saved;
+  } catch {
+    /* blocked or corrupt: start a new streak */
+  }
+  return { now: 0, best: 0 };
+}
+
+/** @param {Streak} streak */
+function saveStreak(streak) {
+  try {
+    localStorage.setItem(STREAK_KEY, JSON.stringify(streak));
+  } catch {
+    /* blocked or full: the streak just isn't kept */
+  }
+}
+
